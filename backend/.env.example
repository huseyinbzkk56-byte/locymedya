PORT=4000

# Rastgele, uzun bir metin yazın (örn. bir şifre üreticiden 64 karakter)
JWT_SECRET=change-this-to-a-long-random-string

# Turso (kalıcı bulut veritabanı) - turso.tech üzerinden alınır
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudinary (kalıcı dosya depolama: mp3, kapak görseli, ekran görüntüsü) - cloudinary.com üzerinden alınır
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Apify hesabınızdan alınacak token - sonraki aşamada eklenecek
# Bu değer olmadan izlenme takip sistemi çalışmaz, sahte veri üretilmez
APIFY_API_TOKEN=

# Apify actor kimlikleri; seçtiğiniz actor dokümantasyonuna göre doldurun
APIFY_TIKTOK_ACTOR_ID=
APIFY_INSTAGRAM_ACTOR_ID=

# İsteğe bağlı: actor input JSON'u. {URL} değeri video URL'siyle değiştirilir.
APIFY_TIKTOK_ACTOR_INPUT=
APIFY_INSTAGRAM_ACTOR_INPUT=
